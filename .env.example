# Sao chép thành .env rồi sửa. KHÔNG đưa tệp .env lên Git.

# dev: bật nguồn tệp mẫu (fixture) để chạy thử. prod: chỉ dùng nguồn thật đã duyệt pháp lý.
APP_ENV=dev

# Địa chỉ chính thức của trang (dùng cho canonical, sitemap, chia sẻ). Ví dụ: https://luckyvision.vn
SITE_URL=http://localhost
# Cách thành viên liên hệ khi quên mật khẩu, hiện trên trang đăng nhập
SUPPORT_CONTACT=Zalo 09xx xxx xxx hoặc email hotro@ten-mien.vn

POSTGRES_DB=luckey
POSTGRES_USER=luckey
POSTGRES_PASSWORD=doi-mat-khau-nay

# Quản trị: đăng nhập bằng tài khoản tại /admin.html (tạo bằng lệnh create-admin).
# ADMIN_TOKENS chỉ dành cho script tự động (bỏ qua xác thực hai lớp, nên để trống nếu không cần).
# Dạng "token:vai_trò:tên", cách nhau dấu phẩy, token tối thiểu 24 ký tự ngẫu nhiên.
# Tạo token: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKENS=

# Tự công bố khi 2 nguồn độc lập khớp nhau (true) hoặc luôn chờ quản trị duyệt (false)
AUTO_VERIFY=true
MIN_MATCHING_SOURCES=2
# Số nguồn cần khớp theo từng miền. vl:1 = tin trang chính thức Vietlott.
# Khi mỗi miền mới có một bộ cào, dùng "vl:1,mn:1,mb:1,mt:1" để tự công bố; để 2 thì kết quả chờ quản trị duyệt.
# Miền Nam có hai nguồn (minhngoc.net, xoso.com.vn) nên có thể đặt mn:2 để tự đối chiếu.
# Lotto 5/35, Keno, Max 3D, Max 3D Pro, Bingo18 lấy thẳng từ trang chính thức Vietlott: mặc định 1 nguồn là đủ.
MIN_SOURCES_BY_REGION=vl:1,mega:1

# Cảnh báo (để trống nếu chưa dùng)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Kênh Telegram công khai nhận kết quả mỗi khi có kỳ được công bố (bot phải là quản trị kênh), ví dụ @luckyvision_kq
TELEGRAM_RESULTS_CHAT_ID=
SLACK_WEBHOOK_URL=
HEALTHCHECKS_URL=

# AI (tùy chọn): trợ lý thống kê và chọn số cho vui.
# AI_PROVIDER=anthropic dùng Claude; AI_PROVIDER=openai dùng mọi dịch vụ theo chuẩn API của OpenAI.
#   Claude:        AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...  (AI_MODEL mặc định claude-haiku-5-5)
#   OpenAI:        AI_PROVIDER=openai     AI_API_KEY=sk-...      AI_MODEL=gpt-4o-mini
#   Google Gemini: AI_PROVIDER=openai     AI_API_KEY=...         AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
#   DeepSeek:      AI_PROVIDER=openai     AI_API_KEY=...         AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
#   OpenRouter:    AI_PROVIDER=openai     AI_API_KEY=...         AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=<tên mô hình>
#   Ollama (máy):  AI_PROVIDER=openai     AI_BASE_URL=http://host.docker.internal:11434/v1  AI_MODEL=qwen2.5  (không cần khóa)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_REQUESTS_PER_MINUTE=6

# Khóa API của nhà cung cấp dữ liệu (tên biến khai báo trong data_sources.config.api_key_env)
PROVIDER_EXAMPLE_API_KEY=

# Triển khai
API_WORKERS=2
SITE_ADDRESS=:80
CLOUDFLARE_TUNNEL_TOKEN=
