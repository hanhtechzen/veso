# Docker Desktop: SITE_ADDRESS=:80 (mặc định) -> http://localhost
# Sau Cloudflare Tunnel: giữ :80, Cloudflare lo HTTPS phía ngoài.
# Mở cổng trực tiếp (không dùng tunnel): SITE_ADDRESS=luckyvision.vn để Caddy tự cấp HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /v1/* /healthz
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Trang quản trị không được lưu đệm ở trình duyệt hay CDN
	@admin path /admin.html /v1/admin/* /v1/auth/*
	header @admin Cache-Control "no-store"
}
