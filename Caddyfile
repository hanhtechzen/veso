# Docker Desktop: SITE_ADDRESS=:80 (mặc định) -> http://localhost
# Sau Cloudflare Tunnel: giữ :80, Cloudflare lo HTTPS phía ngoài.
# Mở cổng trực tiếp (không dùng tunnel): SITE_ADDRESS=luckyvision.vn để Caddy tự cấp HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /v1/* /healthz
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Tệp tĩnh: công cụ tương tác, trang trực tiếp, dự báo, quản trị, ứng dụng cài đặt (PWA)
	@static path /assets/* /icons/* /cong-cu /cong-cu/* /live.html /du-doan.html /admin.html /sw.js /manifest.webmanifest /offline.html
	handle @static {
		root * /srv/web
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
		file_server
	}

	# Mọi trang còn lại (trang chủ, /xsmb, /xsmn-29-10-2026, /xs-tp-hcm, sitemap...) do máy chủ tạo sẵn HTML
	handle {
		reverse_proxy api:8000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; manifest-src 'self'; worker-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Trang quản trị không được lưu đệm ở trình duyệt hay CDN
	@admin path /admin.html /v1/admin/* /v1/auth/*
	header @admin Cache-Control "no-store"
}
